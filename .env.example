# ── Clerk (already configured) ────────────────────────────────────────────────
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Sanity (SEPARATE project for SyntaxHQ) ────────────────────────────────────
# Create a new project at https://www.sanity.io/manage → "Create project".
# Then generate a server-only token: Project → API → Tokens → "Add API token"
# (Viewer is enough for read-only; use Editor if you later mutate from the app).
#
# These are NON-PUBLIC so they never ship to the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_READ_TOKEN=
