---
import { UserButton, OrganizationSwitcher, Show } from '@clerk/astro/react';
import ArmoryFilter from '../components/ArmoryFilter';
import { getPrompts, getSopPlaybooks } from '../lib/data';
import { isEmployee, isSignedIn } from '../lib/auth';
import '../styles/global.css';

export const prerender = false;

// ── Live data from Sanity (falls back to mock data until .env is configured) ──
const [playbooks, prompts] = await Promise.all([getSopPlaybooks(), getPrompts()]);
const employee = isEmployee(Astro);
const signedIn = isSignedIn(Astro);

const statusStyles: Record<string, string> = {
  active: 'text-emerald-400 border-emerald-500/40 bg-emerald-500/10',
  standby: 'text-amber-400 border-amber-500/40 bg-amber-500/10',
  archived: 'text-zinc-500 border-zinc-700 bg-zinc-800/40',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>SyntaxHQ — Prompt Armory</title>
  </head>

  <body class="min-h-screen bg-zinc-950 font-sans text-zinc-200 antialiased">
    <!-- Ambient grid + glow backdrop -->
    <div
      class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_right,#18181b_1px,transparent_1px),linear-gradient(to_bottom,#18181b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_60%,transparent_100%)]"
    >
    </div>
    <div class="pointer-events-none fixed -top-40 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-emerald-500/10 blur-[120px]"></div>

    <div class="relative flex min-h-screen flex-col">
      <!-- ── Sticky Top Navbar ─────────────────────────────────────────── -->
      <header
        class="sticky top-0 z-50 border-b border-zinc-800/80 bg-zinc-950/70 backdrop-blur-xl"
      >
        <div class="flex h-16 items-center justify-between gap-4 px-6">
          <!-- Logo -->
          <a href="/" class="group flex items-center gap-3">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-lg border border-emerald-500/40 bg-emerald-500/10 font-mono text-lg font-bold text-emerald-400 shadow-[0_0_16px_-2px_rgba(16,185,129,0.4)] transition-shadow group-hover:shadow-[0_0_24px_-2px_rgba(16,185,129,0.7)]"
            >
              >_
            </span>
            <div class="leading-tight">
              <span class="block font-mono text-base font-bold tracking-tight text-zinc-50">
                Syntax<span class="text-emerald-400">HQ</span>
              </span>
              <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-500">
                Internal Ops Console
              </span>
            </div>
          </a>

          <!-- Nav links + Status + User -->
          <div class="flex items-center gap-4">
            <nav class="hidden items-center gap-1 font-mono text-xs md:flex">
              {signedIn && (
                <>
                  <a href="/submit" class="rounded-md px-2.5 py-1.5 text-zinc-300 transition-colors hover:bg-zinc-800/60 hover:text-emerald-300">+ Submit</a>
                  <a href="/my" class="rounded-md px-2.5 py-1.5 text-zinc-300 transition-colors hover:bg-zinc-800/60 hover:text-amber-300">My Collection</a>
                </>
              )}
              <a href="/editors-choice" class="rounded-md px-2.5 py-1.5 text-zinc-300 transition-colors hover:bg-zinc-800/60 hover:text-yellow-300">Editor's Choice</a>
              {employee && (
                <>
                  <a href="/review" class="rounded-md px-2.5 py-1.5 text-amber-400 transition-colors hover:bg-zinc-800/60">Review</a>
                  <a href="/studio" class="rounded-md px-2.5 py-1.5 text-emerald-400 transition-colors hover:bg-zinc-800/60">Studio</a>
                </>
              )}
            </nav>
            <span
              class="hidden items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/5 px-3 py-1 font-mono text-[11px] text-emerald-300 sm:inline-flex"
            >
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
              </span>
              {signedIn ? 'SECURE // ONLINE' : 'PUBLIC // READ-ONLY'}
            </span>
            {employee && (
              <div class="hidden md:block" title="Active organization">
                <OrganizationSwitcher
                  client:load
                  appearance={{
                    elements: {
                      organizationSwitcherTrigger:
                        'border border-zinc-700 bg-zinc-900/70 text-zinc-200 rounded-lg px-2.5 py-1.5 font-mono text-xs hover:border-emerald-500/50',
                    },
                  }}
                />
              </div>
            )}
            <Show when="signed-out" client:load>
              <a href="/sign-in" class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 font-mono text-xs font-semibold text-emerald-300 transition-all hover:bg-emerald-500/20 hover:shadow-[0_0_16px_-4px_rgba(16,185,129,0.5)] active:scale-95">
                Sign In
              </a>
            </Show>
            <Show when="signed-in" client:load>
              <div class="rounded-full ring-1 ring-zinc-700/80 transition-shadow hover:ring-emerald-500/50">
                <UserButton client:load />
              </div>
            </Show>
          </div>
        </div>
      </header>

      <!-- ── Body: Sidebar + Main ──────────────────────────────────────── -->
      <div class="mx-auto flex w-full max-w-[1600px] flex-1">
        <!-- Left Sidebar: SOP Playbooks -->
        <aside
          class="hidden w-72 shrink-0 border-r border-zinc-800/80 bg-zinc-900/30 p-5 backdrop-blur-md lg:block"
        >
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-zinc-400">
              SOP Playbooks
            </h2>
            <span class="rounded-md border border-zinc-700 bg-zinc-800/60 px-2 py-0.5 font-mono text-[10px] text-zinc-400">
              {playbooks.length}
            </span>
          </div>

          <nav class="space-y-1.5">
            {playbooks.map((sop) => (
              <a
                href="#"
                class="group flex items-center justify-between gap-2 rounded-lg border border-transparent px-3 py-2.5 transition-all hover:border-zinc-700/80 hover:bg-zinc-800/50"
              >
                <div class="min-w-0">
                  <p class="truncate font-mono text-xs text-zinc-500 group-hover:text-emerald-400">
                    {sop.code}
                  </p>
                  <p class="truncate text-sm font-medium text-zinc-300 group-hover:text-zinc-50">
                    {sop.name}
                  </p>
                </div>
                <span
                  class={`shrink-0 rounded-md border px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wider ${statusStyles[sop.status]}`}
                >
                  {sop.status}
                </span>
              </a>
            ))}
          </nav>

          <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
            <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">Session</p>
            <p class="mt-1 font-mono text-xs text-emerald-300">
              auth: <span class="text-zinc-400">{signedIn ? 'clerk.verified' : 'anonymous'}</span>
            </p>
            <p class="font-mono text-xs text-emerald-300">
              clearance: <span class="text-zinc-400">{employee ? 'employee' : signedIn ? 'operator' : 'guest'}</span>
            </p>
          </div>
        </aside>

        <!-- Main: Prompt Armory -->
        <main class="flex-1 p-6 sm:p-8">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.3em] text-emerald-400">
                // module loaded
              </p>
              <h1 class="mt-1 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">
                Prompt <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Armory</span>
              </h1>
              <p class="mt-2 max-w-xl font-mono text-sm text-zinc-500">
                Battle-tested prompt weapons. Copy, deploy, dominate.
              </p>
            </div>
            <div class="flex items-center gap-2 font-mono text-xs text-zinc-500">
              <span class="rounded-md border border-zinc-800 bg-zinc-900/60 px-2.5 py-1">
                {prompts.length} weapons cached
              </span>
            </div>
          </div>

          {!signedIn && (
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 px-5 py-4">
              <p class="font-mono text-xs text-zinc-400">
                <span class="text-emerald-300">You're browsing read-only.</span> Sign in to collect prompts into your portfolio, rate, and submit.
              </p>
              <a href="/sign-in" class="rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 font-mono text-xs font-semibold text-emerald-300 transition-all hover:bg-emerald-500/20 active:scale-95">
                Sign In →
              </a>
            </div>
          )}

          <!-- Search / filter / sort + grid (client-hydrated) -->
          <ArmoryFilter client:load prompts={prompts} />
        </main>
      </div>

      <!-- Footer strip -->
      <footer class="border-t border-zinc-800/80 bg-zinc-950/60 px-6 py-4 backdrop-blur-md">
        <p class="text-center font-mono text-[11px] tracking-wider text-zinc-600">
          SyntaxHQ <span class="text-zinc-700">//</span> prompt armory <span class="text-zinc-700">//</span>
          <span class="text-emerald-500/80">{signedIn ? 'access logged' : 'public read-only'}</span>
        </p>
      </footer>
    </div>
  </body>
</html>
