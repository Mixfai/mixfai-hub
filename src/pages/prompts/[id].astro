---
import { UserButton } from '@clerk/astro/react';
import FillVariables from '../../components/FillVariables';
import StarRating from '../../components/StarRating';
import CollectButton from '../../components/CollectButton';
import { sanityClient, isSanityConfigured } from '../../lib/sanity';
import { PROMPT_BY_ID_QUERY } from '../../lib/queries';
import type { Prompt } from '../../types';
import '../../styles/global.css';

export const prerender = false;

const { id } = Astro.params;
const userId = Astro.locals.auth()?.userId ?? 'anonymous';

let prompt: Prompt | null = null;
if (isSanityConfigured && sanityClient && id) {
  prompt = await sanityClient.fetch<Prompt | null>(PROMPT_BY_ID_QUERY, { id });
}
if (!prompt) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{prompt.title} — SyntaxHQ</title>
  </head>
  <body class="min-h-screen bg-zinc-950 font-sans text-zinc-200 antialiased">
    <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_right,#18181b_1px,transparent_1px),linear-gradient(to_bottom,#18181b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_60%,transparent_100%)]"></div>

    <div class="relative mx-auto max-w-4xl px-6 py-8">
      <header class="mb-8 flex items-center justify-between">
        <a href="/" class="font-mono text-sm text-emerald-400 hover:text-emerald-300">← armory</a>
        <UserButton client:load />
      </header>

      <div class="mb-2 font-mono text-xs uppercase tracking-[0.3em] text-emerald-400">// prompt detail</div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-50">{prompt.title}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="rounded-md border border-fuchsia-500/30 bg-fuchsia-500/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-fuchsia-300">{prompt.category}</span>
        <span class="rounded-md border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-cyan-300">{prompt.targetModel}</span>
        {prompt.editorsChoice && (
          <span class="rounded-md border border-yellow-500/40 bg-yellow-500/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-yellow-300">★ Editor's Choice</span>
        )}
        <span class="rounded-md border border-zinc-700 bg-zinc-800/60 px-2.5 py-1 font-mono text-[11px] text-zinc-400">
          score {prompt.qualityScore ?? 0}/100 · {prompt.ratingCount ?? 0} ratings
        </span>
      </div>

      {prompt.useCase && <p class="mt-4 font-mono text-sm text-zinc-400">{prompt.useCase}</p>}

      <!-- Full prompt -->
      <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-950/70 p-5">
        <p class="mb-2 font-mono text-[10px] uppercase tracking-widest text-zinc-600">prompt.txt</p>
        <pre class="whitespace-pre-wrap font-mono text-sm leading-relaxed text-emerald-300/90">{prompt.promptContent}</pre>
      </div>

      <!-- Fill variables -->
      <div class="mt-6">
        <FillVariables client:load promptContent={prompt.promptContent} />
      </div>

      <!-- Actions + rating -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-zinc-800 bg-zinc-900/40 p-5">
        <StarRating client:load promptId={prompt._id} userId={userId} />
        <div class="flex items-center gap-3">
          <CollectButton client:load promptId={prompt._id} />
          {prompt.executeUrl && (
            <a href={prompt.executeUrl} target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 rounded-lg border border-fuchsia-500/40 bg-fuchsia-500/10 px-4 py-2 font-mono text-xs font-semibold text-fuchsia-300 transition-all hover:bg-fuchsia-500/20 active:scale-95">
              Execute →
            </a>
          )}
        </div>
      </div>
    </div>
  </body>
</html>
